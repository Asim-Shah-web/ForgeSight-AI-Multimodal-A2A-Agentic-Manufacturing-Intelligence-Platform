# Environment Configuration for ForgeSight AI

# ENVIRONMENT=development
# LOG_LEVEL=INFO
# SECRET_KEY=change-this-in-production

# # API Configuration
# HOST=0.0.0.0
# # PORT=8000

# # LLM & AI Keys (Configure as needed)
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here

# # Database Configuration
# POSTGRES_USER=forgesight
# POSTGRES_PASSWORD=forgesight_pass
# POSTGRES_DB=forgesight_db
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# # Redis Cache & Bus
# REDIS_HOST=localhost
# REDIS_PORT=6379

# # A2A Protocol Settings
# A2A_SERVER_PORT=8010
# A2A_DISCOVERY_URL=http://localhost:8010/a2a/discovery

# # MCP Settings
# MCP_MANUFACTURING_PORT=8020

# ============================================================
# ForgeSight AI - Environment Configuration Example
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# Application
APP_NAME="ForgeSight AI"
APP_VERSION="0.1.0"
DEBUG=false

# Database (PostgreSQL 15+ with pgvector extension)
DATABASE_URL=postgresql+psycopg://forgesight:changeme@localhost:5432/forgesight
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=replace-with-a-random-32-plus-character-secret-key-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CV Model (Phase 3)
CV_MODEL_PATH=models/vision/checkpoints/yolov8-forgesight.pt
CV_CONFIDENCE_THRESHOLD=0.5

# RAG / Embeddings (Phase 4, ADR-005)
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024
RAG_RETRIEVAL_TOP_K=20
RAG_RERANK_TOP_K=5

# MCP (Phase 5)
MCP_MANUFACTURING_SERVER_URL=http://localhost:9001
MCP_DOCUMENTS_SERVER_URL=http://localhost:9002

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173