# Environment Configuration for ForgeSight AI

ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production

# API Configuration
HOST=0.0.0.0
PORT=8000

# LLM & AI Keys (Configure as needed)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Database Configuration
POSTGRES_USER=forgesight
POSTGRES_PASSWORD=forgesight_pass
POSTGRES_DB=forgesight_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Cache & Bus
REDIS_HOST=localhost
REDIS_PORT=6379

# A2A Protocol Settings
A2A_SERVER_PORT=8010
A2A_DISCOVERY_URL=http://localhost:8010/a2a/discovery

# MCP Settings
MCP_MANUFACTURING_PORT=8020
