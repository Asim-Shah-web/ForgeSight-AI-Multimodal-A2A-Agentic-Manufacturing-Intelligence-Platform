# ============================================================
# ForgeSight AI - PRODUCTION environment. Copy to .env.production
# and fill in real values. NEVER commit .env.production.
# ============================================================

APP_NAME="ForgeSight AI"
DEBUG=false

# Database
POSTGRES_USER=forgesight
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_PASSWORD
POSTGRES_DB=forgesight
DATABASE_URL=postgresql+psycopg://forgesight:REPLACE_WITH_A_STRONG_RANDOM_PASSWORD@db:5432/forgesight

# Redis
REDIS_URL=redis://redis:6379/0

# Security — generate with: openssl rand -base64 32
SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_32_OUTPUT
ACCESS_TOKEN_EXPIRE_MINUTES=480

# LLM
GROQ_API_KEY=REPLACE_WITH_REAL_GROQ_API_KEY

# MCP
MCP_MANUFACTURING_SERVER_URL=http://mcp-manufacturing:9001
MCP_DOCUMENTS_SERVER_URL=http://mcp-documents:9002

# Tracing — point at your real observability backend, not a local Jaeger
TRACING_OTLP_ENDPOINT=https://your-otlp-collector.example.com:4317
TRACING_SAMPLE_RATE=0.1

# CORS — restrict to your real frontend domain
CORS_ALLOWED_ORIGINS=https://forgesight.yourcompany.com